{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "$id": "https://smart-data-models.github.io/dataModel.EnergyStorage/HydrogenStorageMeasurement/schema.json,",
  "title": "Hydrogen Storage measuremet data model",
  "description": "A instantaneous measure of pressure and ambient temperature in a hydrogen storage tank",
  "modelTags": "",
  "derivedFrom": "",
  "license": "https://smart-data-models.github.io/dataModel.EnergyStorage/HydrogenStorageMeasurement/LICENSE.md",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "type": {
          "type": "string",
          "enum": ["FuelCellMeasurement"],
          "description": "Property. NGSI Entity type. It has to be FuelCellMeasurement"
        },
        "pressure": {
          "type": "number",
          "description": "Property. Pressure (bar). Units:'bar'"
        },
        "temperature": {
          "type": "number",
          "description": "Property. Ambient temperature (ºC). Units:'degrees celsius'"
        },
        "refHydrogenStorage": {
          "type": "string",
          "format": "uri",
          "description": "Relationship. A reference to the entity HydrogenStorage which it belongs the measurement"
        },
        "hydrogenFlowConsumed": {
          "type": "number",
          "description": "Property. Flow of hydrogen consumed"
        },
        "powerGenerated": {
          "type": "number",
          "description": "Property. Power generated (W). Units:'watts'"
        },
        "refFuelCell": {
          "type": "string",
          "format": "uri",
          "description": "Relationship. Uri referencing the fuel cell"
        }
      }
    }
  ],
  "required": [
    "id",
    "type"
  ]
}