{
  "$schema": "http://json-schema.org/schema#",
  "$schemaVersion": "0.0.1",
  "$id": "https://smart-data-models.github.io/dataModel.EnergyStorage/ElectrolyzerMeasurement/schema.json,",
  "title": "Electrolyzer measurement data model",
  "description": "A instantaneous measure of hydrogen generation / power consumption by a electrolyzer",
  "modelTags": "",
  "derivedFrom": "",
  "license": "https://smart-data-models.github.io/dataModel.EnergyStorage/ElectrolyzerMeasurement/LICENSE.md",
  "type": "object",
  "allOf": [
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/GSMA-Commons"
    },
    {
      "$ref": "https://smart-data-models.github.io/data-models/common-schema.json#/definitions/Location-Commons"
    },
    {
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ElectrolyzerMeasurement"],
          "description": "Property. NGSI Entity type. It has to be ElectrolyzerMeasurement"
        },
        "hydrogenFlowGenerated": {
          "type": "number",
          "description": "Property. Hydrogen flow production (NL/h)"
        },
        "powerConsumed": {
          "type": "number",
          "description": "Property. Power consumed (W). Units:'watts'"
        },
        "refElectrolyzer": {
          "type": "string",
          "format": "uri",
          "description": "Relationship. A reference to the entity Electrolyzer which it belongs the measurement"
        }
      }
    }
  ],
  "required": [
    "id",
    "type"
  ]
}